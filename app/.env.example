# Data mode: "api" (live SQL Server via the Node API — the default) or "mock"
# (deterministic fixtures, opt-in offline dev).
# "api" is the default: the app launches against the live BRKR_ERP database so orders,
# clients, and order-detail sub-tables show only real data (no fictitious data). The
# server resolves a managed profile and reads from BRKR_ERP; the browser sends no
# credentials. The vitest runner ignores this and always uses mock fixtures.
# Set "mock" ONLY for offline work without the server — note the Clients tab has no
# mock repository and will show a load error in mock mode without the server.
VITE_DATA_MODE=api

# Node API base URL. Used by the HTTP repositories (api mode) and the Administration
# connection manager. In local development, Vite proxies /api to http://localhost:4000.
VITE_API_BASE_URL=/api
# Do not add ADMIN_API_TOKEN as a VITE_ variable; enter it in Administration at runtime.