NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
ADMIN_API_TOKEN=
ALLOW_AD_HOC_CONNECTIONS=true
AD_HOC_TRUST_SERVER_CERTIFICATE=false

# Profile names are demo placeholders. Replace SERVER / USER / PASSWORD / DATABASE
# with the values appropriate for your environment before bringing the stack up.
PROFILES=demo-primary,demo-secondary
ORDERS_PROFILE_ID=demo-primary

PROFILE__DEMO_PRIMARY__NAME=Demo Primary
PROFILE__DEMO_PRIMARY__SERVER=replace-me.example.internal
PROFILE__DEMO_PRIMARY__PORT=1433
PROFILE__DEMO_PRIMARY__USER=replace-me
PROFILE__DEMO_PRIMARY__PASSWORD=replace-me
PROFILE__DEMO_PRIMARY__DATABASE=replace_me
PROFILE__DEMO_PRIMARY__TRUST_SERVER_CERTIFICATE=false

PROFILE__DEMO_SECONDARY__NAME=Demo Secondary
PROFILE__DEMO_SECONDARY__SERVER=replace-me.example.internal
PROFILE__DEMO_SECONDARY__PORT=1433
PROFILE__DEMO_SECONDARY__USER=replace-me
PROFILE__DEMO_SECONDARY__PASSWORD=replace-me
PROFILE__DEMO_SECONDARY__DATABASE=replace_me
PROFILE__DEMO_SECONDARY__TRUST_SERVER_CERTIFICATE=false
