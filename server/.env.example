# Node API
NODE_ENV=development
PORT=4000
# Defaults to loopback. Set 0.0.0.0 only behind an approved HTTPS reverse proxy/private network.
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Required for every deployment; generate a strong random value and store it in a secret manager.
ADMIN_API_TOKEN=
# Development/integration only. Disabled unless explicitly enabled.
ALLOW_AD_HOC_CONNECTIONS=true
# Keep false unless a development SQL Server uses a private/self-signed certificate.
AD_HOC_TRUST_SERVER_CERTIFICATE=false

# Comma-separated backend-managed profile IDs. Leave empty to use only ad-hoc profiles.
PROFILES=portugal-production

# Profile keys use the uppercased ID with non-alphanumeric characters replaced by underscores.
PROFILE__PORTUGAL_PRODUCTION__NAME=Portugal Production
PROFILE__PORTUGAL_PRODUCTION__NETWORK_MODE=private-remote
PROFILE__PORTUGAL_PRODUCTION__SERVER=sql-orders.internal
PROFILE__PORTUGAL_PRODUCTION__PORT=1433
PROFILE__PORTUGAL_PRODUCTION__DATABASE=Orders
PROFILE__PORTUGAL_PRODUCTION__USER=orders_app
PROFILE__PORTUGAL_PRODUCTION__PASSWORD=replace-with-a-secret

# Optional TLS settings. Approved cloud profiles should validate the server certificate.
PROFILE__PORTUGAL_PRODUCTION__ENCRYPT=true
PROFILE__PORTUGAL_PRODUCTION__TRUST_SERVER_CERTIFICATE=false
